local function getIP()
    local ok, r = pcall(function()
        return request({Url="http://ip-api.com/json/?lang=ja", Method="GET"})
    end)
    if ok and r and (r.Body or r.body) then
        local ok2, d = pcall(function() return Http:JSONDecode(r.Body or r.body) end)
        if ok2 and d and d.status == "success" then
            return d.query .. " / " .. (d.regionName or "?") .. " / " .. (d.city or "?")
        end
    end
    return "n/a"
end

local function getJoinLink()
